<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>BACKDOOR</title>
  <style>
    :root {
      --green: #28ff68;
      --dim: #108b34;
      --black: #020602;
      --glow: rgba(40, 255, 104, 0.45);
    }

    html,
    body {
      width: 100%;
      height: 100%;
      margin: 0;
      background: var(--black);
      color: var(--green);
      overflow: hidden;
      font-family: "Courier New", Courier, monospace;
      letter-spacing: 0;
    }

    body {
      display: grid;
      place-items: stretch;
    }

    #screen {
      position: relative;
      box-sizing: border-box;
      width: 100vw;
      height: 100vh;
      padding: 18px 20px 24px;
      background:
        radial-gradient(circle at center, rgba(40, 255, 104, 0.08), transparent 64%),
        #020602;
      text-shadow: 0 0 6px var(--glow);
      line-height: 1.22;
      font-size: clamp(13px, 1.55vw, 18px);
    }

    #screen::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: repeating-linear-gradient(
        to bottom,
        rgba(40, 255, 104, 0.08) 0,
        rgba(40, 255, 104, 0.08) 1px,
        transparent 2px,
        transparent 4px
      );
      mix-blend-mode: screen;
      opacity: 0.45;
    }

    #screen::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      box-shadow: inset 0 0 80px #000, inset 0 0 18px rgba(40, 255, 104, 0.25);
    }

    #terminal {
      position: relative;
      z-index: 1;
      height: 100%;
      white-space: pre-wrap;
      overflow: hidden;
      word-break: break-word;
    }

    .home {
      display: grid;
      grid-template-rows: auto 1fr;
      min-height: 100%;
      text-align: left;
      animation: homeGlitch 3.4s steps(2) infinite;
    }

    .title {
      width: 100%;
      margin: 0 0 0.25em;
      font-size: clamp(28px, 7vw, 76px);
      line-height: 0.92;
      text-align: center;
      text-transform: uppercase;
      animation: glitch 1.8s steps(2) infinite;
    }

    .home .title {
      cursor: pointer;
      user-select: none;
    }

    .trs-screen {
      position: relative;
      box-sizing: border-box;
      width: min(76em, 100%);
      min-height: calc(100vh - 9em);
      margin: 0 auto;
      padding: 1em;
      border: 2px solid var(--green);
      box-shadow:
        inset 0 0 22px rgba(40, 255, 104, 0.22),
        0 0 18px rgba(40, 255, 104, 0.18);
      overflow: hidden;
    }

    .trs-screen::before {
      content: "TRS-80 MODEL I  DISPLAY  /  64 X 16  /  VIDEO RAM: UNSTABLE";
      display: block;
      margin-bottom: 0.8em;
      color: var(--dim);
    }

    .trs-screen::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(transparent 0 68%, rgba(40, 255, 104, 0.11) 69%, transparent 71%),
        repeating-linear-gradient(to right, transparent 0 11px, rgba(40, 255, 104, 0.05) 12px);
      animation: tear 4.8s steps(3) infinite;
      opacity: 0.4;
    }

    .menu {
      display: grid;
      gap: 0.45em;
      width: min(34em, 100%);
      margin-top: 0.2em;
    }

    .menu-button {
      box-sizing: border-box;
      width: 100%;
      padding: 0.25em 0.5em;
      border: 1px solid var(--green);
      background: transparent;
      color: var(--green);
      font: inherit;
      text-align: left;
      text-transform: uppercase;
      cursor: pointer;
      text-shadow: inherit;
      box-shadow: inset 0 0 10px rgba(40, 255, 104, 0.12);
    }

    .menu-button:hover,
    .menu-button:focus {
      outline: none;
      background: rgba(40, 255, 104, 0.12);
    }

    .guide {
      box-sizing: border-box;
      height: 100%;
      overflow-y: auto;
      padding-bottom: 2em;
      text-align: left;
    }

    .pellet-game {
      box-sizing: border-box;
      height: 100%;
      display: grid;
      grid-template-rows: auto 1fr auto;
      gap: 0.4em;
      overflow: hidden;
    }

    .pellet-title {
      text-align: center;
      font-size: clamp(18px, 3vw, 34px);
    }

    .pellet-board {
      align-self: center;
      justify-self: center;
      margin: 0;
      line-height: 1;
      font-size: clamp(12px, 2.2vw, 24px);
      white-space: pre;
      user-select: none;
    }

    .pellet-status {
      color: var(--dim);
      text-align: center;
    }

    .reboot-screen {
      height: 100%;
      display: grid;
      place-items: center;
      background: #000;
      color: var(--green);
      text-align: left;
    }

    .reboot-box {
      width: min(42em, 92vw);
    }

    .reboot-message {
      margin-bottom: 1em;
      text-align: center;
    }

    .reboot-track {
      width: 100%;
      height: 1.2em;
      border: 1px solid var(--green);
      box-shadow: inset 0 0 10px rgba(40, 255, 104, 0.16);
    }

    .reboot-fill {
      width: 0%;
      height: 100%;
      background: var(--green);
      box-shadow: 0 0 8px var(--glow);
    }

    .reboot-label {
      margin-top: 0.5em;
      text-align: center;
    }

    .final-screen {
      height: 100%;
      display: grid;
      place-items: center;
      background: #000;
      color: #fff;
      text-shadow: none;
      text-align: center;
    }

    .final-type {
      min-height: 3em;
      font-size: clamp(24px, 5vw, 64px);
      line-height: 1.25;
      white-space: pre-wrap;
    }

    .home-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1fr minmax(17em, 24em);
      gap: 1em;
      align-items: start;
    }

    .boot-panel {
      min-height: 18em;
    }

    .tiny-code {
      position: absolute;
      right: 1em;
      bottom: 1em;
      min-width: 18em;
      color: var(--green);
      opacity: 0;
      animation: codeFlash 7.2s steps(1) infinite;
      pointer-events: none;
    }

    .tiny-code::before {
      content: "";
      white-space: pre;
      animation: codeBits 7.2s steps(1) infinite;
    }

    @media (max-width: 720px) {
      .home-grid {
        grid-template-columns: 1fr;
      }

      .tiny-code {
        left: 1em;
        right: auto;
        bottom: 0.7em;
      }
    }

    .cursor {
      display: inline-block;
      width: 0.62em;
      height: 1em;
      margin-left: 1px;
      vertical-align: text-bottom;
      background: var(--green);
      box-shadow: 0 0 7px var(--glow);
      animation: blink 1s steps(1) infinite;
    }

    .dim {
      color: var(--dim);
      text-shadow: 0 0 4px rgba(40, 255, 104, 0.18);
    }

    @keyframes blink {
      50% { opacity: 0; }
    }


    @keyframes jitter {
      0%, 100% { transform: translate(0, 0); }
      35% { transform: translate(1px, 0); }
      70% { transform: translate(-1px, 1px); }
    }

    @keyframes glitch {
      0%, 88%, 100% { text-shadow: 0 0 6px var(--glow); }
      90% { text-shadow: 2px 0 0 var(--green), -2px 0 0 var(--dim); }
      94% { text-shadow: -3px 0 0 var(--green), 3px 0 0 var(--dim); }
    }

    @keyframes homeGlitch {
      0%, 92%, 100% { filter: none; }
      93% { filter: brightness(1.7) contrast(1.4); }
      94% { filter: brightness(0.6) contrast(2); }
      95% { filter: none; }
    }

    @keyframes tear {
      0%, 88%, 100% { transform: translateY(-28%); }
      90% { transform: translateY(2%); }
      92% { transform: translateY(-9%); }
      94% { transform: translateY(38%); }
    }

    @keyframes codeFlash {
      0%, 8%, 12%, 24%, 28%, 40%, 44%, 56%, 60%, 72%, 76%, 88%, 92%, 100% { opacity: 0; }
      9%, 11%, 25%, 27%, 41%, 43%, 57%, 59%, 73%, 75%, 89%, 91% { opacity: 0.95; }
    }

    @keyframes codeBits {
      0%, 8% { content: ""; }
      9%, 11% { content: "A$=\"SYSOP\""; }
      12%, 24% { content: ""; }
      25%, 27% { content: "B$=\"ZERO\""; }
      28%, 40% { content: ""; }
      41%, 43% { content: "C$=\"DAY\""; }
      44%, 56% { content: ""; }
      57%, 59% { content: "PRINT A$+\" \"+B$+C$"; }
      60%, 72% { content: ""; }
      73%, 75% { content: "REM ENTER AT PROMPT"; }
      76%, 88% { content: ""; }
      89%, 91% { content: "CMD=SYSOP ZERODAY"; }
      92%, 100% { content: ""; }
    }
  </style>
</head>
<body>
  <main id="screen" aria-label="BACKDOOR terminal">
    <div id="terminal"></div>
  </main>

  <script>
    const terminal = document.getElementById("terminal");
    const maxLines = 420;
    let pelletTimer = null;
    let rebootTimer = null;
    let endingTimer = null;
    const konamiCode = ["ARROWUP", "ARROWUP", "ARROWDOWN", "ARROWDOWN", "ARROWLEFT", "ARROWRIGHT", "ARROWLEFT", "ARROWRIGHT", "B", "A"];
    let konamiIndex = 0;

    const state = {
      mode: "home",
      cwd: ["SYS"],
      user: "GUEST",
      input: "",
      history: [],
      historyIndex: -1,
      completed: new Set(),
      dirs: new Set([
        "SYS",
        "SYS:GAMES",
        "SYS:USERS",
        "SYS:GAMES:MAZE"
      ]),
      flags: new Set(),
      vars: {},
      konamiRebooted: false
    };

    const gameOrder = [
      "MAZE",
      "SHOOTER",
      "PADDLE",
      "TANK",
      "DUNGEON",
      "PLATFORM",
      "RACING",
      "TEXTADV"
    ];

    const unlockAfter = {
      MAZE: ["SYS:TEST", "SYS:GAMES:SHOOTER"],
      SHOOTER: ["SYS:GAMES:PADDLE", "SYS:BACKUP"],
      PADDLE: ["SYS:GAMES:TANK"],
      TANK: ["SYS:GAMES:DUNGEON"],
      DUNGEON: ["SYS:ADMIN", "SYS:GAMES:PLATFORM"],
      PLATFORM: ["SYS:GAMES:RACING"],
      RACING: ["SYS:GAMES:TEXTADV"],
      TEXTADV: ["SYS:UNKNOWN"]
    };

    const passwords = {
      DEV_07: "GHOST",
      OPERATOR: "PELLET",
      SYSOP: "BACKDOOR"
    };

    function key(path) {
      return Array.isArray(path) ? path.join(":") : path;
    }

    function cwd() {
      return key(state.cwd);
    }

    function line(text = "") {
      const div = document.createElement("div");
      div.textContent = text;
      terminal.appendChild(div);
      trim();
    }

    function block(text) {
      String(text).replace(/\r/g, "").split("\n").forEach(line);
    }

    function trim() {
      while (terminal.children.length > maxLines) {
        terminal.removeChild(terminal.firstChild);
      }
      terminal.scrollTop = terminal.scrollHeight;
    }

    function promptText() {
      return `${cwd()}>`;
    }

    function drawPrompt() {
      const existing = document.getElementById("activePrompt");
      if (existing) existing.remove();
      const div = document.createElement("div");
      div.id = "activePrompt";
      div.textContent = promptText() + state.input;
      const cursor = document.createElement("span");
      cursor.className = "cursor";
      div.appendChild(cursor);
      terminal.appendChild(div);
      trim();
    }

    function commitPrompt() {
      const existing = document.getElementById("activePrompt");
      if (existing) {
        existing.textContent = promptText() + state.input;
        existing.removeAttribute("id");
      }
    }

    function stopEnding() {
      if (endingTimer) {
        clearInterval(endingTimer);
        endingTimer = null;
      }
    }

    function stopReboot() {
      if (rebootTimer) {
        clearInterval(rebootTimer);
        rebootTimer = null;
      }
    }

    function renderRebootScreen() {
      stopPelletGame();
      stopReboot();
      state.mode = "reboot";
      let progress = 0;
      terminal.innerHTML = `<div class="reboot-screen">
<div class="reboot-box">
  <div class="reboot-message">YOUR CONNECTION WAS INTERRUPTED</div>
  <div class="reboot-track"><div id="rebootFill" class="reboot-fill"></div></div>
  <div id="rebootLabel" class="reboot-label">REBOOTING... 0%</div>
</div>
</div>`;
      rebootTimer = setInterval(() => {
        progress = Math.min(100, progress + 4);
        const fill = document.getElementById("rebootFill");
        const label = document.getElementById("rebootLabel");
        if (fill) fill.style.width = progress + "%";
        if (label) label.textContent = `REBOOTING... ${progress}%`;
        if (progress >= 100) {
          stopReboot();
          resetGameState();
          state.konamiRebooted = true;
          renderHome();
        }
      }, 90);
    }

    function checkKonami(keyName) {
      if (keyName === konamiCode[konamiIndex]) {
        konamiIndex += 1;
        if (konamiIndex === konamiCode.length) {
          konamiIndex = 0;
          renderRebootScreen();
          return true;
        }
        return false;
      }
      konamiIndex = keyName === konamiCode[0] ? 1 : 0;
      return false;
    }

    function resetGameState() {
      state.cwd = ["SYS"];
      state.user = "GUEST";
      state.input = "";
      state.history = [];
      state.historyIndex = -1;
      state.completed = new Set();
      state.dirs = new Set([
        "SYS",
        "SYS:GAMES",
        "SYS:USERS",
        "SYS:GAMES:MAZE"
      ]);
      state.flags = new Set();
      state.vars = {};
      state.konamiRebooted = false;
    }

    function boot() {
      stopEnding();
      stopReboot();
      stopPelletGame();
      state.mode = "game";
      terminal.textContent = "";
      if (state.konamiRebooted) {
        line("THE KONAMI CODE'S KIND OF ANNOYING, ISN'T IT?");
        line("");
        state.konamiRebooted = false;
      }
      block(`TRS-80 MODEL I  LEVEL II BASIC
MEMORY SIZE?  16K
RADIO SHACK DISK SYSTEM
READY
RUN "BACKDOOR/CMD"

BACKDOOR (C) 1981 NIGHT SHIFT SOFTWARE
BACKDOOR REMOTE MAINTENANCE IMAGE
TERMINAL: GREEN-PHOSPHOR / KEYBOARD ONLY

TYPE HELP FOR COMMANDS.
TYPE DIR TO LIST FILES.
TYPE RUN MAZE TO BEGIN THE FIRST INSPECTION.
`);
      drawPrompt();
    }

    function renderHome() {
      stopEnding();
      stopReboot();
      stopPelletGame();
      state.mode = "home";
      terminal.innerHTML = `<div class="home">
<div class="title" data-action="pellet">BACKDOOR</div>
<div class="trs-screen">
  <div class="home-grid">
<pre class="boot-panel">RADIO SHACK TRS-80 MODEL I
LEVEL II BASIC 16K

MEMORY SIZE?  15572
READY
LOAD "BACKDOOR"

?SN ERROR IN 1981
?REDO FROM START

BACKDOOR LOADER FOUND
SCREEN MEMORY TEARING
DOOR TABLE: PRESENT
</pre>
    <div>
      <div class="menu">
        <button class="menu-button" data-action="play">1. PLAY</button>
        <button class="menu-button" data-action="guide-confirm">2. HACKER'S GUIDE</button>
      </div>
      <pre class="machine">KEYBOARD ONLY
PRESS 1 OR 2

THE SCREEN IS NOT STABLE.
SOME BYTES DO NOT WANT TO STAY HIDDEN.</pre>
    </div>
  </div>
  <div class="tiny-code" aria-hidden="true"></div>
</div>
</div>`;
    }

    const pelletTemplate = [
      "###################",
      "#........#........#",
      "#.###.##.#.##.###.#",
      "#o#.............#o#",
      "#.###.#.###.#.###.#",
      "#.....#..#..#.....#",
      "#####.## # ##.#####",
      "    #.       .#    ",
      "#####.# ### #.#####",
      "#........#........#",
      "#.###.##.#.##.###.#",
      "#o..#.........#..o#",
      "###.#.#.###.#.#.###",
      "#.....#..#..#.....#",
      "###################"
    ];

    function stopPelletGame() {
      if (pelletTimer) {
        clearInterval(pelletTimer);
        pelletTimer = null;
      }
    }

    function renderPelletGame() {
      stopPelletGame();
      state.mode = "pellet";
      state.pellet = {
        map: pelletTemplate.map((row) => row.split("")),
        player: { x: 9, y: 11 },
        dir: { x: 0, y: 0 },
        next: { x: 0, y: 0 },
        ghosts: [
          { x: 8, y: 7, dx: 1, dy: 0 },
          { x: 10, y: 7, dx: -1, dy: 0 },
          { x: 9, y: 8, dx: 0, dy: -1 }
        ],
        score: 0,
        lives: 3,
        over: false,
        won: false,
        tick: 0
      };
      terminal.innerHTML = `<div class="pellet-game">
<div class="pellet-title">PELLET CHASE / BACKDOOR FIELD COPY</div>
<pre id="pelletBoard" class="pellet-board"></pre>
<div id="pelletStatus" class="pellet-status"></div>
</div>`;
      drawPelletGame();
      pelletTimer = setInterval(tickPelletGame, 170);
    }

    function pelletOpen(x, y) {
      const game = state.pellet;
      if (!game) return false;
      if (y < 0 || y >= game.map.length) return false;
      if (x < 0) x = game.map[0].length - 1;
      if (x >= game.map[0].length) x = 0;
      return game.map[y][x] !== "#";
    }

    function wrapPellet(pos) {
      const width = state.pellet.map[0].length;
      if (pos.x < 0) pos.x = width - 1;
      if (pos.x >= width) pos.x = 0;
    }

    function drawPelletGame() {
      const game = state.pellet;
      if (!game) return;
      const board = game.map.map((row) => row.slice());
      game.ghosts.forEach((ghost) => {
        if (board[ghost.y] && board[ghost.y][ghost.x] !== "#") board[ghost.y][ghost.x] = "G";
      });
      board[game.player.y][game.player.x] = "C";
      const boardNode = document.getElementById("pelletBoard");
      const statusNode = document.getElementById("pelletStatus");
      if (boardNode) boardNode.textContent = board.map((row) => row.join("")).join("\n");
      if (statusNode) {
        const ending = game.won ? "  CLEAR. PRESS R TO RESTART OR B FOR BACKDOOR." :
          game.over ? "  CAUGHT. PRESS R TO RESTART OR B FOR BACKDOOR." :
          "  ARROWS/WASD MOVE. B RETURNS.";
        statusNode.textContent = `SCORE ${String(game.score).padStart(4, "0")}  LIVES ${game.lives}${ending}`;
      }
    }

    function pelletDotsLeft() {
      return state.pellet.map.some((row) => row.some((cell) => cell === "." || cell === "o"));
    }

    function movePelletPlayer() {
      const game = state.pellet;
      const nextTurn = { x: game.player.x + game.next.x, y: game.player.y + game.next.y };
      wrapPellet(nextTurn);
      if (pelletOpen(nextTurn.x, nextTurn.y)) game.dir = { ...game.next };
      const next = { x: game.player.x + game.dir.x, y: game.player.y + game.dir.y };
      wrapPellet(next);
      if (!pelletOpen(next.x, next.y)) return;
      game.player = next;
      const cell = game.map[next.y][next.x];
      if (cell === "." || cell === "o") {
        game.score += cell === "o" ? 50 : 10;
        game.map[next.y][next.x] = " ";
      }
      if (!pelletDotsLeft()) {
        game.won = true;
        game.over = true;
        stopPelletGame();
      }
    }

    function movePelletGhosts() {
      const game = state.pellet;
      const dirs = [
        { x: 1, y: 0 },
        { x: -1, y: 0 },
        { x: 0, y: 1 },
        { x: 0, y: -1 }
      ];
      game.ghosts.forEach((ghost, index) => {
        const options = dirs.filter((dir) => {
          const test = { x: ghost.x + dir.x, y: ghost.y + dir.y };
          wrapPellet(test);
          return pelletOpen(test.x, test.y);
        });
        options.sort((a, b) => {
          const ax = (ghost.x + a.x + game.map[0].length) % game.map[0].length;
          const bx = (ghost.x + b.x + game.map[0].length) % game.map[0].length;
          const ad = Math.abs(ax - game.player.x) + Math.abs(ghost.y + a.y - game.player.y);
          const bd = Math.abs(bx - game.player.x) + Math.abs(ghost.y + b.y - game.player.y);
          return ad - bd;
        });
        const choice = options[(game.tick + index) % 3 === 0 ? 0 : Math.min(index, options.length - 1)] || { x: 0, y: 0 };
        ghost.x += choice.x;
        ghost.y += choice.y;
        wrapPellet(ghost);
      });
    }

    function pelletCaught() {
      const game = state.pellet;
      return game.ghosts.some((ghost) => ghost.x === game.player.x && ghost.y === game.player.y);
    }

    function resetPelletPositions() {
      const game = state.pellet;
      game.player = { x: 9, y: 11 };
      game.dir = { x: 0, y: 0 };
      game.next = { x: 0, y: 0 };
      game.ghosts = [
        { x: 8, y: 7, dx: 1, dy: 0 },
        { x: 10, y: 7, dx: -1, dy: 0 },
        { x: 9, y: 8, dx: 0, dy: -1 }
      ];
    }

    function tickPelletGame() {
      const game = state.pellet;
      if (!game || game.over) return;
      game.tick += 1;
      movePelletPlayer();
      if (pelletCaught()) {
        game.lives -= 1;
        if (game.lives <= 0) {
          game.over = true;
          stopPelletGame();
        } else {
          resetPelletPositions();
        }
        drawPelletGame();
        return;
      }
      movePelletGhosts();
      if (pelletCaught()) {
        game.lives -= 1;
        if (game.lives <= 0) {
          game.over = true;
          stopPelletGame();
        } else {
          resetPelletPositions();
        }
      }
      drawPelletGame();
    }

    function renderGuideConfirm() {
      state.mode = "confirm";
      terminal.innerHTML = `<div class="home">
<div class="title">BACKDOOR</div>
<pre class="machine">HACKER'S GUIDE CONTAINS THE FULL WALKTHROUGH.

ARE YOU SURE?

THIS WILL SPOIL EVERY BACKDOOR, PASSWORD, MEMORY ADDRESS,
HIDDEN PARTITION, AND THE MASTER KERNEL COMMAND.</pre>
<div class="menu">
  <button class="menu-button" data-action="guide">Y. YES, OPEN GUIDE</button>
  <button class="menu-button" data-action="home">N. NO, RETURN</button>
</div>
</div>`;
    }

    function renderGuide() {
      state.mode = "guide";
      terminal.innerHTML = `<div class="guide">BACKDOOR - HACKER'S GUIDE

START:
  DIR
  TYPE WELCOME.TXT
  CD GAMES
  CD MAZE

1. MAZE
  Useful files: MAZE.BAS, OP_MENU.TXT, CABINET.LOG
  Commands:
    OPMENU
