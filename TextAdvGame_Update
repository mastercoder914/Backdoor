      stopEnding();
      state.mode = "ending";
      terminal.innerHTML = `<div class="final-screen"><div id="finalType" class="final-type"></div></div>`;
      const message = "GAME OVER\n\nDEVELOPER: BANANA GAMES";
      const target = document.getElementById("finalType");
      let index = 0;
      endingTimer = setInterval(() => {
        if (!target) {
          stopEnding();
          return;
        }
        target.textContent = message.slice(0, index);
        index += 1;
        if (index > message.length) stopEnding();
      }, 95);
    }

    function cmdKernel(args) {
      const clean = args.trim().toUpperCase();
      if (clean === "BACKDOOR 1981" && state.dirs.has("SYS:UNKNOWN")) {
        state.user = "SYSOP";
        renderFinalEnding();
      } else {
        line("KERNEL REJECTED.");
      }
    }

    function autoWin() {
      gameOrder.forEach((game) => state.completed.add(game));
      [
        "SYS:TEST",
        "SYS:BACKUP",
        "SYS:ADMIN",
        "SYS:ARCHIVE",
        "SYS:UNKNOWN",
        "SYS:GAMES:SHOOTER",
        "SYS:GAMES:PADDLE",
        "SYS:GAMES:TANK",
        "SYS:GAMES:DUNGEON",
        "SYS:GAMES:PLATFORM",
        "SYS:GAMES:RACING",
        "SYS:GAMES:TEXTADV"
      ].forEach((dir) => state.dirs.add(dir));
      state.user = "SYSOP";
      state.vars.LAP = "FF";
      state.vars.SPEED = "00";
      state.vars.SHELLS = "00";
      block(`
ZERO-DAY MAINTENANCE VECTOR ACCEPTED.
ALL LOCK BYTES FORCED OPEN.
SYSOP SESSION BORROWED FROM A DEAD LOGIN.

BACKDOOR DOES NOT ASK HOW YOU FOUND THIS.
IT ONLY OPENS.

MASTER BACKDOOR OPEN.
*** EASTER EGG AUTO-WIN ***
TYPE STATUS OR CD SYS:UNKNOWN.`);
    }

    function parse(raw) {
      const command = raw.trim();
      if (!command) return;
      const upper = command.toUpperCase();
      const [verb, ...restParts] = upper.split(/\s+/);
      const rest = restParts.join(" ");

      if (["SYSOP ZERODAY", "CMD=SYSOP ZERODAY", "CMD SYSOP ZERODAY", "RUN SYSOP ZERODAY"].includes(upper)) autoWin();
      else if (verb === "HELP" || verb === "?") cmdHelp();
      else if (verb === "CLS" || verb === "CLEAR") terminal.textContent = "";
      else if (verb === "DIR" || verb === "LS") cmdDir();
      else if (verb === "TREE") cmdTree();
      else if (verb === "CD") cmdCd(rest);
      else if (verb === "TYPE" || verb === "CAT" || verb === "READ") cmdType(rest);
      else if (verb === "RUN" || verb === "PLAY") gameScreen(restParts[0] || "");
      else if (verb === "STATUS") cmdStatus();
      else if (verb === "HEX") cmdHex(rest);
      else if (verb === "LOGIN") cmdLogin(rest);
      else if (verb === "LOGOUT") { state.user = "GUEST"; line("LOGGED OUT."); }
      else if (verb === "POKE") cmdPoke(rest);
      else if (verb === "SET") cmdSet(rest);
      else if (verb === "MOUNT") cmdMount(rest);
      else if (verb === "SCAN") cmdScan(rest);
      else if (verb === "UNDELETE") line("UNDELETE TABLE DAMAGED. TRY SCAN.");
      else if (verb === "OPMENU") block(`OPERATOR MENU
1. SOUND TEST
2. COIN COUNTER
3. OPEN EXIT

TYPE THE SERVICE COMMAND.`);
      else if (upper === "OPEN EXIT") complete("MAZE");
      else if (upper === "BOUNCE 999") complete("PADDLE");
      else if (verb === "JUMPTEST" && rest === "7") complete("PLATFORM");
      else if (upper === "SAY BACKDOOR") complete("TEXTADV");
      else if (verb === "KERNEL") cmdKernel(rest);
      else if (upper === "DEBUG FREEZE" || upper === "FREEZE ENEMY") line("DEBUG ALIAS FOUND. MAP SAYS TO USE POKE 2A FF.");
      else if (upper === "LOOK") line("THE SCREEN LOOKS BACK.");
      else line("SYNTAX ERROR");
    }

    document.addEventListener("keydown", (event) => {
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      const keyName = event.key.toUpperCase();
      if (checkKonami(keyName)) {
        event.preventDefault();
        return;
      }
      if (state.mode === "reboot" || state.mode === "ending") {
        event.preventDefault();
        return;
      }
      if (state.mode === "pellet") {
        event.preventDefault();
        const dirs = {
          ARROWUP: { x: 0, y: -1 }, W: { x: 0, y: -1 },
          ARROWDOWN: { x: 0, y: 1 }, S: { x: 0, y: 1 },
          ARROWLEFT: { x: -1, y: 0 }, A: { x: -1, y: 0 },
          ARROWRIGHT: { x: 1, y: 0 }, D: { x: 1, y: 0 }
        };
        if (dirs[keyName] && state.pellet && !state.pellet.over) state.pellet.next = dirs[keyName];
        else if (keyName === "R") renderPelletGame();
        else if (keyName === "B" || keyName === "ESCAPE") renderHome();
        return;
      }
      if (state.mode === "home") {
        if (keyName === "1" || keyName === "P" || keyName === "ENTER") boot();
        if (keyName === "2" || keyName === "H") renderGuideConfirm();
        return;
      }
      if (state.mode === "confirm") {
        if (keyName === "Y" || keyName === "ENTER") renderGuide();
        if (keyName === "N" || keyName === "ESCAPE" || keyName === "B") renderHome();
        return;
      }
      if (state.mode === "guide") {
        if (keyName === "B" || keyName === "ESCAPE") renderHome();
        return;
      }
      if (event.key === "Backspace") {
        event.preventDefault();
        state.input = state.input.slice(0, -1);
        drawPrompt();
      } else if (event.key === "Enter") {
        event.preventDefault();
        const raw = state.input;
        commitPrompt();
        if (raw.trim()) {
          state.history.push(raw);
          state.historyIndex = state.history.length;
        }
        state.input = "";
        parse(raw);
        drawPrompt();
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        if (state.history.length) {
          state.historyIndex = Math.max(0, state.historyIndex - 1);
          state.input = state.history[state.historyIndex] || "";
          drawPrompt();
        }
      } else if (event.key === "ArrowDown") {
        event.preventDefault();
        if (state.history.length) {
          state.historyIndex = Math.min(state.history.length, state.historyIndex + 1);
          state.input = state.history[state.historyIndex] || "";
          drawPrompt();
        }
      } else if (event.key.length === 1) {
        event.preventDefault();
        state.input += event.key.toUpperCase();
        drawPrompt();
      }
    });

    terminal.addEventListener("click", (event) => {
      const action = event.target.dataset && event.target.dataset.action;
      if (action === "play") boot();
      else if (action === "pellet") renderPelletGame();
      else if (action === "guide-confirm") renderGuideConfirm();
      else if (action === "guide") renderGuide();
      else if (action === "home") renderHome();
      else if (state.mode === "game") drawPrompt();
    });
    renderHome();
  </script>
</body>
</html>
