    function cmdDir() {
      const here = cwd();
      const entries = entriesFor(here);
      line(`DIRECTORY OF ${here}`);
      if (!entries.dirs.length && !entries.files.length) {
        line("  <EMPTY>");
        return;
      }
      entries.dirs.forEach((d) => line(`  ${d.padEnd(12)} <DIR>`));
      entries.files.forEach((f) => line(`  ${f}`));
    }

    function cmdTree() {
      const walk = (path, depth) => {
        const name = path.split(":").pop();
        line(`${"  ".repeat(depth)}${name}${depth === 0 ? ":" : ""}`);
        entriesFor(path).dirs.forEach((d) => walk(path + ":" + d, depth + 1));
      };
      walk("SYS", 0);
    }

    function cmdCd(arg) {
      const path = resolvePath(arg);
      if (!isVisibleDir(path)) {
        line("DIRECTORY NOT FOUND OR LOCKED.");
        return;
      }
      state.cwd = path.split(":");
    }

    function cmdType(arg) {
      if (!arg) {
        line("TYPE WHAT?");
        return;
      }
      const upper = arg.toUpperCase();
      let path = cwd();
      let name = upper;
      if (upper.includes(":") || upper.includes("/")) {
        const parts = resolvePath(upper).split(":");
        name = parts.pop();
        path = parts.join(":");
      }
      if (!isVisibleDir(path)) {
        line("PATH NOT AVAILABLE.");
        return;
      }
      const files = allFiles()[path] || [];
      if (!files.includes(name)) {
        line("FILE NOT FOUND.");
        if (state.completed.size > 3) line("...OR WAS IT REMOVED?");
        return;
      }
      block(fileText(path, name));
    }

