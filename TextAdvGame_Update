    function resolvePath(raw) {

      if (!raw || raw === ".") return cwd();
      const clean = raw.toUpperCase().replace(/^\/+|\/+$/g, "").replace(/\//g, ":");
      if (clean === "..") {
        const parent = state.cwd.slice(0, -1).join(":");
        return parent || "SYS";
      }

      if (clean.startsWith("SYS")) return clean;
      const parts = clean.split(":").filter(Boolean);
      let base = state.cwd.slice();
      for (const part of parts) {
        if (part === ".") continue;
        if (part === "..") base.pop();
        else base.push(part);
      }
      return base.join(":");
    }


    function complete(game) {
      if (state.completed.has(game)) {
        line(`${game} ALREADY OPEN.`);
        return;
      }
      state.completed.add(game);
      (unlockAfter[game] || []).forEach((dir) => state.dirs.add(dir));
      block(`
*** ${game} LOCK FAILED ***
EXIT VECTOR OPEN.
NEW DIRECTORY ACCESS GRANTED.`);
      if (game === "TEXTADV") {
        block(`
SYS:UNKNOWN HAS APPEARED.
THE DIRECTORY WAS NOT CREATED.
IT WAS WAITING.`);
      }
    }

