      const parts = args.trim().toUpperCase().replace(/\$/g, "").split(/\s+/);
      if (parts.length < 2) {
        line("POKE <ADDR> <VAL>");
        return;
      }
      const [addr, val] = parts;
      state.vars["MEM_" + addr] = val;
      line(`MEMORY ${addr} <- ${val}`);
      if (addr === "2A" && val === "FF") complete("SHOOTER");
      else if (addr === "C0DE" && (val === "01" || val === "1")) complete("DUNGEON");
      else line("NO VISIBLE EFFECT.");
