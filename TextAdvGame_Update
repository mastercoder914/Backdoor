      if (varName === "SHELLS" && val === "00") complete("TANK");
      if ((varName === "LAP" && val === "FF" && state.vars.SPEED === "00") ||
          (varName === "SPEED" && val === "00" && state.vars.LAP === "FF")) {
        complete("RACING");
      }
    }

    function cmdMount(arg) {
      const name = arg.trim().toUpperCase();
      if (name !== "ARCHIVE") {
        line("NO SUCH PARTITION.");
